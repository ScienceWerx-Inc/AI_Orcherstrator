{
  "name": "ai-middleware",
  "version": "0.1.0",
  "private": true,
  "description": "Multi-tenant AI infrastructure platform: unified gateway, model registry, routing, metering and admin console.",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @ai-mw/gateway test:e2e",
    "db:generate": "pnpm --filter @ai-mw/gateway prisma:generate",
    "db:migrate": "pnpm --filter @ai-mw/gateway prisma:migrate",
    "db:deploy": "pnpm --filter @ai-mw/gateway prisma:deploy",
    "db:seed": "pnpm --filter @ai-mw/gateway prisma:seed",
    "db:studio": "pnpm --filter @ai-mw/gateway prisma:studio",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "3.4.2",
    "turbo": "2.3.3",
    "typescript": "5.7.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@nestjs/core",
      "@prisma/client",
      "@prisma/engines",
      "nestjs-pino",
      "prisma"
    ]
  }
}
