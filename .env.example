# ─── Core ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
DASHBOARD_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000
LOG_LEVEL=info
TRUST_PROXY=false

# ─── Data stores ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_middleware?schema=public
# Optional. When unset the gateway uses in-process fallbacks for rate limiting and
# budget caching, which is fine for single-instance local development only.
REDIS_URL=redis://localhost:6379

# Used by docker compose for the bundled PostgreSQL service. Keep DATABASE_URL
# pointing at localhost for host-run processes; compose overrides it with the
# postgres service hostname.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_middleware

# ─── Security ────────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-development-only-jwt-secret-0123456789
JWT_EXPIRES_IN=12h
# 32-byte key, base64 or hex. Generate with: openssl rand -base64 32
# Never rotate this without re-encrypting provider credentials.
ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
# Admin bootstrap used by `pnpm db:seed` only. Change before any shared deployment.
SEED_ADMIN_EMAIL=admin@local.dev
SEED_ADMIN_PASSWORD=admin12345
SEED_ORG_NAME=Local AI Platform

# ─── Gateway limits ──────────────────────────────────────────────────────────
MAX_REQUEST_BYTES=1048576
PROVIDER_TIMEOUT_MS=60000
PROVIDER_MAX_RETRIES=1
CIRCUIT_FAILURE_THRESHOLD=5
CIRCUIT_OPEN_MS=30000
RATE_LIMIT_ENABLED=true

# ─── Providers (all optional; the mock provider always works) ────────────────
# These are fallbacks. Credentials stored through the admin API take precedence.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_ENABLED=false
MOCK_PROVIDER_LATENCY_MS=0

# ─── Observability ───────────────────────────────────────────────────────────
# Reserved: OpenTelemetry export is not wired in Phase 1 (Prometheus + JSON logs).
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ai-gateway
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── Seed options ────────────────────────────────────────────────────────────
# Mock provider is dev-only and disabled by default. Enabling it makes chat
# requests return synthetic text; never enable it where real usage is recorded.
SEED_MOCK_PROVIDER=false

# ─── Dashboard (server-side only; never exposed to browser) ───────────────────
# Preferred variable. ADMIN_API_URL is kept as a backwards-compatible fallback.
GATEWAY_URL=http://localhost:4000
ADMIN_API_URL=http://localhost:4000

# ─── Docker Compose / Grafana ────────────────────────────────────────────────
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ─── Optional ML service (apps/ml-service) ───────────────────────────────────
# The API runs without these; readiness is degraded and model calls return 503
# until real backends and models are installed.
ML_ENVIRONMENT=development
ML_INTERNAL_TOKEN=
ML_MODEL_DIR=
ML_DEVICE=cpu
ML_MAX_BATCH_SIZE=32
ML_EMBEDDING_MODELS=
ML_RERANK_MODELS=
ML_INFERENCE_MODELS=
# e.g. embedding:BAAI/bge-small-en-v1.5,rerank:BAAI/bge-reranker-base
ML_PRELOAD_MODELS=
# Host directory bind-mounted at /models in the ml profile.
ML_MODEL_DIR_HOST=./models
# Build-time extras for the ml-service image: embeddings, inference, or both.
ML_EXTRAS=
